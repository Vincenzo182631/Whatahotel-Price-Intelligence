# Local development environment — COPY, DO NOT EDIT THIS FILE.
#
#   cp .env.example .env
#   ${EDITOR:-nano} .env
#
# `.env` is gitignored. This template is not, so it must never contain a real
# value. If you find yourself pasting a key in here, you are in the wrong file.
#
# Loading: the npm scripts pass `--env-file-if-exists=.env`, so `npm run
# collect` and friends pick this up with no extra step. Nothing else does —
# `npm test` and any direct `node`/`psql` invocation read the ambient
# environment, so for those:
#
#   set -a; . ./.env; set +a
#
# Precedence: an already-exported variable WINS over `.env`. That is deliberate
# and load-bearing — it means CI secrets can never be shadowed by a stray file,
# and a one-off override still works:
#
#   WAH_API_KEY=other-key npm run collect -- --dry-run

# ── The WhataHotel data API key ──────────────────────────────────────────────
# A credential. Environment only: never commit it, never pass it on a command
# line in a shared shell (it lands in history and in `ps`), never paste it into
# an issue or a log. `redact()` strips it from every URL this project logs.
WAH_API_KEY=replace-me

# ── Database ─────────────────────────────────────────────────────────────────
# The local development database created by `npm run db:up`.
# Integration tests skip entirely when this is unset, so `npm test` still works
# without a database.
DATABASE_URL=postgres://wahpi:wahpi@localhost:5433/wahpi

# ── Google Places (optional) ─────────────────────────────────────────────────
# Powers the guest-rating context shown beside the price. A credential: server
# side only. It must NEVER appear in HTML, in widget JavaScript, in a data
# attribute, or in any variable a bundler would inline into the browser — the
# page talks to our API, and only our API talks to Google.
#
# Unset, the reputation sweep reports NOT_CONFIGURED and everything else works
# exactly as before. The rating is context, never a term in any score.
# GOOGLE_PLACES_API_KEY=replace-me
# Weekly. A guest rating is an average over thousands of reviews — it moves by
# hundredths over months, and refreshing it daily costs 7x for precision the
# signal does not have. Measured: 3,033 resolvable hotels is ~92,000 billed
# calls a month at 24h, ~13,200 at 168h.
# GOOGLE_PLACES_REFRESH_HOURS=168
# GOOGLE_PLACES_TIMEOUT_MS=4000
# GOOGLE_PLACES_MIN_MATCH_CONFIDENCE=0.7

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Rewords the already-computed explanation into readable English. Same rule:
# server side only, never in the browser.
#
# The model never computes. It receives a bundle of finished facts and its
# output is validated against that bundle's numeric allowlist before display —
# a draft that invents a number or predicts a price is discarded, and the
# deterministic sentences ship instead. Unset, those sentences ship always.
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=6000
# OPENAI_INTELLIGENCE_CACHE_MINUTES=60

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to 0 to silence per-request API logging.
# LOG_REQUESTS=1

# Required by scripts/seed-dev.mjs, which fabricates rates that are
# indistinguishable from real ones once stored. Leave this OUT of .env and pass
# it explicitly on the command line, so it can never be set by accident:
#   ALLOW_SYNTHETIC_SEED=1 npm run db:seed-dev
